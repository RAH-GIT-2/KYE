<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the KYE icon (or drag these onto the home screen). Google Assistant can open them too. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="speak"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mic"
        android:shortcutShortLabel="@string/shortcut_speak_short"
        android:shortcutLongLabel="@string/shortcut_speak_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.kye.app.MainActivity"
            android:targetPackage="com.kye.app">
            <extra android:name="kye.action" android:value="voice" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="add"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_short"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.kye.app.MainActivity"
            android:targetPackage="com.kye.app">
            <extra android:name="kye.action" android:value="add" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="ask"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_ask"
        android:shortcutShortLabel="@string/shortcut_ask_short"
        android:shortcutLongLabel="@string/shortcut_ask_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.kye.app.MainActivity"
            android:targetPackage="com.kye.app">
            <extra android:name="kye.action" android:value="ask" />
        </intent>
    </shortcut>
</shortcuts>
